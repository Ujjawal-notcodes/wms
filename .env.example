# ─────────────────────────────────────────────────────────────────────────────
# WMS — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_DB=wms
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=wms_password
POSTGRES_PORT=5432

# Full connection URL (used by Drizzle + API)
DATABASE_URL=postgresql://wms_user:wms_password@localhost:5432/wms

# ─────────────────────────────────────────────
# API — Fastify
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
LOG_LEVEL=info

# JWT — CHANGE THESE IN PRODUCTION (min 64 chars, random)
JWT_SECRET=change-this-to-a-very-long-random-secret-string-minimum-64-chars
JWT_REFRESH_SECRET=change-this-to-another-very-long-random-secret-string-min-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated origins allowed
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────
# Web — Next.js
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-secret-for-next-auth-session-encryption

# ─────────────────────────────────────────────
# Seed Configuration
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@wms.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ORG_NAME=Acme Industrial
SEED_ORG_CODE=ACME
