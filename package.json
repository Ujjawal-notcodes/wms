{
  "name": "wms",
  "version": "0.1.0",
  "private": true,
  "description": "Warehouse Management System — monorepo root",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @wms/db db:generate",
    "db:migrate": "pnpm --filter @wms/db db:migrate",
    "db:push": "pnpm --filter @wms/db db:push",
    "db:studio": "pnpm --filter @wms/db db:studio",
    "db:seed": "pnpm --filter @wms/db db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
